# ============================================================
# Bahir Tech — environment reference
# Copy to .env (git-ignored) and fill in real values.
# ============================================================

# --- Application ---
# NEXT_PUBLIC_SITE_URL=https://bahirtech.com

# --- Database (Phases 1+) — PostgreSQL connection string ---
# Layout: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local Windows install (PostgreSQL 18) example:
#   DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/bahirtech
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/bahirtech

# --- Auth (Phase 3 — session secret) ---
# AUTH_SECRET=

# --- Admin account (Phase 3) — used by `npm run db:admin` to create/login ---
# ADMIN_EMAIL=admin@bahirtech.com
# ADMIN_PASSWORD=change-me-to-a-long-password
# ADMIN_NAME=Bahir Tech Admin